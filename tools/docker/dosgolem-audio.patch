diff --git a/oracle/opl_progress.go b/oracle/opl_progress.go
new file mode 100644
index 0000000..ed63961
--- /dev/null
+++ b/oracle/opl_progress.go
@@ -0,0 +1,251 @@
+package oracle
+
+import (
+	"errors"
+	"github.com/wicanr2/dosgolem/internal/machine"
+)
+
+// OPLProgressQuantum 是完成指令後的觀察間隔。介面只可由同一 owner 使用。
+const OPLProgressQuantum uint64 = 200000
+const OPLSourceCapacity = machine.OPLStreamCapacity
+
+var ErrOPLProgressReentrant = errors.New("OPL 進度觀察期間禁止重入")
+
+type OPLProgressToken struct {
+	owner      *Oracle
+	generation uint64
+}
+type CompletedOPL struct {
+	Step, FirstSequence                   uint64
+	Writes                                []OPLWrite
+	Final                                 bool
+	OperationErrorCode, ObserverFaultCode string
+}
+type OPLProgressOpt func(*oplProgressConfig)
+type oplProgressConfig struct{ stream bool }
+
+// WithOPLStream 保留有界的未交付來源；未指定時保持完整 trace 相容。
+func WithOPLStream() OPLProgressOpt { return func(c *oplProgressConfig) { c.stream = true } }
+
+type OPLSourceStats struct {
+	Stream            bool
+	Pending           int
+	Recorded, Dropped uint64
+	FaultCode         string
+}
+
+func (o *Oracle) OPLSourceStats() OPLSourceStats {
+	return OPLSourceStats{o.m.OPLStream, len(o.m.OPL), o.m.OPLRecorded, o.m.OPLDropped, o.OPLProgressFault()}
+}
+
+type oplProgressState struct {
+	fn                          func(CompletedOPL)
+	token                       OPLProgressToken
+	generation                  uint64
+	cursor                      int
+	nextSequence, deliveredStep uint64
+	busy, callback              bool
+	operation, fault            string
+}
+
+func (o *Oracle) InstallOPLProgress(quantum uint64, fn func(CompletedOPL), opts ...OPLProgressOpt) (OPLProgressToken, error) {
+	p := &o.oplProgress
+	if p.busy || p.callback {
+		return OPLProgressToken{}, ErrOPLProgressReentrant
+	}
+	if quantum != OPLProgressQuantum || fn == nil || p.fn != nil {
+		return OPLProgressToken{}, errors.New("OPL 註冊條件不符")
+	}
+	cfg := oplProgressConfig{}
+	for _, opt := range opts {
+		if opt == nil {
+			return OPLProgressToken{}, errors.New("OPL 選項無效")
+		}
+		opt(&cfg)
+	}
+	if o.m.OPLStream || cfg.stream && (o.m.Steps != 0 || len(o.m.OPL) != 0) {
+		return OPLProgressToken{}, errors.New("OPL 串流只允冷安裝")
+	}
+	if p.generation == ^uint64(0) {
+		return OPLProgressToken{}, errors.New("OPL token 已耗盡")
+	}
+	p.generation++
+	p.token = OPLProgressToken{o, p.generation}
+	p.fn = fn
+	p.cursor = len(o.m.OPL)
+	p.deliveredStep = o.m.Steps
+	p.fault = ""
+	if p.nextSequence == 0 {
+		p.nextSequence = uint64(len(o.m.OPL)) + 1
+	}
+	if cfg.stream {
+		o.m.EnableOPLStream()
+	}
+	return p.token, nil
+}
+func (o *Oracle) RemoveOPLProgress(token OPLProgressToken) error {
+	p := &o.oplProgress
+	if p.busy || p.callback {
+		return ErrOPLProgressReentrant
+	}
+	if token != p.token || token.owner != o || token.generation == 0 {
+		return errors.New("OPL token 不符")
+	}
+	if p.fn == nil && p.fault == "" {
+		return errors.New("OPL 已卸載")
+	}
+	p.fn = nil
+	p.token = OPLProgressToken{}
+	return nil
+}
+func (o *Oracle) OPLProgressFault() string {
+	if o.oplProgress.fault != "" {
+		return o.oplProgress.fault
+	}
+	return o.m.OPLStreamFault
+}
+func (o *Oracle) failOPL(code string) {
+	p := &o.oplProgress
+	if p.fault == "" {
+		p.fault = code
+	}
+	p.fn = nil
+	if o.m.OPLStream && o.m.OPLStreamFault == "" {
+		o.m.OPLStreamFault = p.fault
+	}
+}
+func (o *Oracle) rejectOPLVoidReentry(code string) bool {
+	if !o.oplProgress.callback {
+		return false
+	}
+	if o.oplProgress.fault == "" {
+		o.oplProgress.fault = code
+	}
+	return true
+}
+func (o *Oracle) beginOPLOperation(name string) (bool, error) {
+	p := &o.oplProgress
+	if p.callback || p.busy {
+		return false, ErrOPLProgressReentrant
+	}
+	if p.fn == nil {
+		return false, nil
+	}
+	p.busy = true
+	p.operation = name
+	return true, nil
+}
+func (o *Oracle) finishOPLOperation(err error) {
+	defer func() { o.oplProgress.busy = false; o.oplProgress.operation = "" }()
+	o.deliverOPL(true, err)
+}
+func operationErrorCode(err error) string {
+	if err == nil {
+		return ""
+	}
+	var b *BudgetError
+	var x *ExitError
+	var n *NoResponseError
+	switch {
+	case errors.Is(err, ErrOPLProgressReentrant):
+		return "reentrant"
+	case errors.As(err, &b):
+		return "budget"
+	case errors.As(err, &x):
+		return "exit"
+	case errors.As(err, &n):
+		return "no_response"
+	default:
+		return "execution"
+	}
+}
+func (o *Oracle) completedOPLStep() {
+	p := &o.oplProgress
+	if o.m.OPLStreamFault != "" && p.fn != nil {
+		o.failOPL(o.m.OPLStreamFault)
+		return
+	}
+	if p.fn != nil && p.busy && o.m.Steps >= p.deliveredStep && o.m.Steps-p.deliveredStep >= OPLProgressQuantum {
+		o.deliverOPL(false, nil)
+	}
+}
+func (o *Oracle) deliverOPL(final bool, operationErr error) {
+	p := &o.oplProgress
+	if p.fn == nil {
+		return
+	}
+	if o.m.OPLStreamFault != "" {
+		o.failOPL(o.m.OPLStreamFault)
+		return
+	}
+	step := o.m.Steps
+	if step < p.deliveredStep {
+		o.failOPL("watermark_backward")
+		return
+	}
+	if p.cursor > len(o.m.OPL) {
+		o.failOPL("source_sequence_truncated")
+		return
+	}
+	count := len(o.m.OPL) - p.cursor
+	// 先守門，才配置獨立批次副本；舊完整 trace 本身仍不設總量限制。
+	if count > OPLSourceCapacity {
+		o.failOPL("event_capacity")
+		return
+	}
+	source := o.m.OPL[p.cursor:]
+	previous := p.deliveredStep
+	for i, w := range source {
+		if w.Step > step {
+			o.failOPL("event_after_watermark")
+			return
+		}
+		if w.Step <= p.deliveredStep || i > 0 && w.Step < previous {
+			o.failOPL("event_late_or_reversed")
+			return
+		}
+		previous = w.Step
+	}
+	if uint64(count) > ^uint64(0)-p.nextSequence {
+		o.failOPL("sequence_overflow")
+		return
+	}
+	writes := append([]OPLWrite(nil), source...)
+	batch := CompletedOPL{step, p.nextSequence, writes, final, operationErrorCode(operationErr), p.fault}
+	p.cursor = len(o.m.OPL)
+	p.nextSequence += uint64(count)
+	p.deliveredStep = step
+	p.callback = true
+	returned := false
+	defer func() {
+		p.callback = false
+		if !returned {
+			_ = recover()
+			o.failOPL("callback_panic")
+		}
+	}()
+	p.fn(batch)
+	returned = true
+	if p.fault != "" {
+		o.failOPL(p.fault)
+		return
+	}
+	if o.m.OPLStream {
+		// owner 同步回呼正常返回後，來源批次及其底層陣列退場。
+		o.m.OPL = nil
+		p.cursor = 0
+	}
+}
+func (o *Oracle) runOPL(n uint64) error { return o.runUntilOPL(Steps(n), Budget(n+1)) }
+func (o *Oracle) watchedRunOPL(n uint64) error {
+	if o.oplProgress.busy && o.oplProgress.operation == "Click" && !o.oplProgress.callback {
+		return o.runOPL(n)
+	}
+	return o.Run(n)
+}
+func (o *Oracle) watchedUntilOPL(c Cond, opts ...RunOpt) error {
+	if o.oplProgress.busy && o.oplProgress.operation == "Click" && !o.oplProgress.callback {
+		return o.runUntilOPL(c, opts...)
+	}
+	return o.RunUntil(c, opts...)
+}
diff --git a/oracle/opl_progress_test.go b/oracle/opl_progress_test.go
new file mode 100644
index 0000000..712c54f
--- /dev/null
+++ b/oracle/opl_progress_test.go
@@ -0,0 +1,209 @@
+package oracle
+
+import (
+	"crypto/sha256"
+	"github.com/wicanr2/dosgolem/internal/dos"
+	"github.com/wicanr2/dosgolem/internal/machine"
+	"reflect"
+	"testing"
+)
+
+func oplFixture(t *testing.T, code []byte) *Oracle {
+	t.Helper()
+	m := machine.New()
+	m.SetAdLib(true)
+	if e := m.LoadCOM(code); e != nil {
+		t.Fatal("自製COM載入")
+	}
+	d := dos.New(m, t.TempDir())
+	d.Install()
+	return &Oracle{m: m, d: d, onCall: map[uint32][]func(*Oracle){}}
+}
+func oplLoop() []byte {
+	return []byte{0xfa, 0xba, 0x88, 3, 0xb0, 0xa0, 0xee, 0x42, 0xb0, 1, 0xee, 0x4a, 0xeb, 0xf6}
+}
+func oplSame(t *testing.T, a, b *Oracle) {
+	t.Helper()
+	if a.Steps() != b.Steps() || a.Regs() != b.Regs() || sha256.Sum256(a.m.Mem) != sha256.Sum256(b.m.Mem) || a.OPLRegs(0) != b.OPLRegs(0) || a.OPLRegs(1) != b.OPLRegs(1) {
+		t.Fatal("原CPU/記憶體/暫存器不同")
+	}
+}
+func TestOPLStreamLegacyParityAndRelease(t *testing.T) {
+	base := oplFixture(t, oplLoop())
+	o := oplFixture(t, oplLoop())
+	var got []OPLWrite
+	next := uint64(1)
+	batches := 0
+	tok, e := o.InstallOPLProgress(OPLProgressQuantum, func(b CompletedOPL) {
+		if b.FirstSequence != next {
+			t.Fatal("來源序號")
+		}
+		next += uint64(len(b.Writes))
+		got = append(got, b.Writes...)
+		batches++
+	}, WithOPLStream())
+	if e != nil {
+		t.Fatal(e)
+	}
+	for _, n := range []uint64{400037, 300011, 1} {
+		if base.Run(n) != nil || o.Run(n) != nil {
+			t.Fatal("自製Run")
+		}
+		if len(o.OPLWrites()) != 0 || cap(o.m.OPL) != 0 {
+			t.Fatal("交付來源未釋放")
+		}
+	}
+	oplSame(t, base, o)
+	if !reflect.DeepEqual(base.OPLWrites(), got) || batches != 6 {
+		t.Fatal("完整/stream事件不同")
+	}
+	st := o.OPLSourceStats()
+	if st.Recorded != uint64(len(got)) || st.Pending != 0 || st.Dropped != 0 || st.FaultCode != "" {
+		t.Fatal("來源對帳")
+	}
+	if e := o.RemoveOPLProgress(tok); e != nil {
+		t.Fatal(e)
+	}
+	if _, e := o.InstallOPLProgress(OPLProgressQuantum, func(CompletedOPL) {}, WithOPLStream()); e == nil {
+		t.Fatal("warm再次安裝")
+	}
+}
+func TestOPLStreamSourceCapacityAndFaultBound(t *testing.T) {
+	o := oplFixture(t, oplLoop())
+	calls := 0
+	if _, e := o.InstallOPLProgress(OPLProgressQuantum, func(CompletedOPL) { calls++ }, WithOPLStream()); e != nil {
+		t.Fatal(e)
+	}
+	o.m.Out8(0x388, 0xa0)
+	for i := 0; i < OPLSourceCapacity+10; i++ {
+		o.m.Out8(0x389, uint8(i))
+	}
+	if len(o.OPLWrites()) != OPLSourceCapacity || o.OPLProgressFault() != "event_capacity" || o.OPLRegs(0)[0xa0] != uint8((OPLSourceCapacity+9)%256) {
+		t.Fatal("append前容量與regs")
+	}
+	if o.Run(1000) != nil || calls != 0 || len(o.OPLWrites()) != OPLSourceCapacity {
+		t.Fatal("容量故障未有界")
+	}
+	if o.OPLSourceStats().Dropped < 10 {
+		t.Fatal("故障尾段未計數")
+	}
+}
+func TestOPLStreamCallbackPanicPreservesRun(t *testing.T) {
+	for _, final := range []bool{false, true} {
+		a := oplFixture(t, oplLoop())
+		b := oplFixture(t, oplLoop())
+		calls := 0
+		tok, e := b.InstallOPLProgress(OPLProgressQuantum, func(x CompletedOPL) {
+			calls++
+			if x.Final == final {
+				panic("自製回呼違約")
+			}
+		}, WithOPLStream())
+		if e != nil {
+			t.Fatal(e)
+		}
+		if a.Run(400037) != nil || b.Run(400037) != nil {
+			t.Fatal("原返回被改")
+		}
+		oplSame(t, a, b)
+		if b.OPLProgressFault() != "callback_panic" {
+			t.Fatal("有限fault")
+		}
+		before := calls
+		if a.Run(200037) != nil || b.Run(200037) != nil {
+			t.Fatal("後續Run")
+		}
+		oplSame(t, a, b)
+		if calls != before || len(b.OPLWrites()) > OPLSourceCapacity {
+			t.Fatal("故障listener反覆/累積")
+		}
+		if e := b.RemoveOPLProgress(tok); e != nil {
+			t.Fatal("idle故障token清理")
+		}
+	}
+}
+func TestOPLProgressRunUntilClickAndErrors(t *testing.T) {
+	a := oplFixture(t, oplLoop())
+	b := oplFixture(t, oplLoop())
+	finals := 0
+	last := CompletedOPL{}
+	_, e := b.InstallOPLProgress(OPLProgressQuantum, func(x CompletedOPL) {
+		last = x
+		if x.Final {
+			finals++
+		}
+	}, WithOPLStream())
+	if e != nil {
+		t.Fatal(e)
+	}
+	// 條件各自建立以保存原 API 的狀態語意。
+	c1 := NewCond("自製步數", func(o *Oracle) bool { return o.Steps() == 200037 })
+	c2 := NewCond("自製步數", func(o *Oracle) bool { return o.Steps() == 200037 })
+	if a.RunUntil(c1, Budget(200038)) != nil || b.RunUntil(c2, Budget(200038)) != nil || !last.Final || last.Step != 200037 {
+		t.Fatal("RunUntil餘數")
+	}
+	opt := []ClickOpt{NoCursorWait(), Hover(17), Hold(200037), Settle(19), Frame(func(*Oracle) []uint8 { return []byte{1} })}
+	ea, eb := a.Click(10, 10, opt...), b.Click(10, 10, opt...)
+	if reflect.TypeOf(ea) != reflect.TypeOf(eb) || last.OperationErrorCode != "no_response" || finals != 2 {
+		t.Fatal("整包Click Final")
+	}
+	oplSame(t, a, b)
+	for _, code := range [][]byte{{0xfa, 0xf4}, {0xb8, 0, 0x4c, 0xcd, 0x21}} {
+		x := oplFixture(t, code)
+		var last CompletedOPL
+		_, e := x.InstallOPLProgress(OPLProgressQuantum, func(b CompletedOPL) { last = b }, WithOPLStream())
+		if e != nil {
+			t.Fatal(e)
+		}
+		if x.Run(10) == nil || !last.Final || last.Step == 0 || last.OperationErrorCode == "" {
+			t.Fatal("錯誤前進水位")
+		}
+	}
+}
+func TestOPLProgressReentryAndColdGuard(t *testing.T) {
+	o := oplFixture(t, oplLoop())
+	other := oplFixture(t, oplLoop())
+	var token OPLProgressToken
+	token, _ = o.InstallOPLProgress(OPLProgressQuantum, func(b CompletedOPL) {
+		before := o.Steps()
+		regs := o.OPLRegs(0)
+		if o.Run(1) != ErrOPLProgressReentrant || o.RemoveOPLProgress(token) != ErrOPLProgressReentrant {
+			t.Fatal("busy重入")
+		}
+		o.ClearOPL()
+		o.Restore(nil)
+		if o.Steps() != before || o.OPLRegs(0) != regs {
+			t.Fatal("違約side effect")
+		}
+	})
+	if e := o.RemoveOPLProgress(OPLProgressToken{other, 1}); e == nil {
+		t.Fatal("跨owner token")
+	}
+	if o.Run(200037) != nil || o.OPLProgressFault() != "clear_opl_reentrant" {
+		t.Fatal("有限void故障")
+	}
+	w := oplFixture(t, oplLoop())
+	if w.Run(1) != nil {
+		t.Fatal("warm fixture")
+	}
+	if _, e := w.InstallOPLProgress(OPLProgressQuantum, func(CompletedOPL) {}, WithOPLStream()); e == nil {
+		t.Fatal("warm guard")
+	}
+}
+
+// 新進度批次的 copy 有界；舊 OPLWrites 完整 trace 不因該守門退場。
+func TestOPLProgressLegacyCopyCapacity(t *testing.T) {
+	o := oplFixture(t, oplLoop())
+	calls := 0
+	if _, e := o.InstallOPLProgress(OPLProgressQuantum, func(CompletedOPL) { calls++ }); e != nil {
+		t.Fatal(e)
+	}
+	o.m.Steps = 1
+	o.m.Out8(0x388, 0xa0)
+	for i := 0; i <= OPLSourceCapacity; i++ {
+		o.m.Out8(0x389, 1)
+	}
+	if o.Run(0) != nil || calls != 0 || o.OPLProgressFault() != "event_capacity" || len(o.OPLWrites()) != OPLSourceCapacity+1 {
+		t.Fatal("copy前守門與legacy相容")
+	}
+}
